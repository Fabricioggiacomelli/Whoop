# Copie este arquivo para .env e preencha os valores. Nunca commite o .env real.

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
APP_TIMEZONE="America/Sao_Paulo"

# ── Banco (Postgres — Neon recomendado) ─────────────────────────────────
# String de conexão padrão do driver `pg`. Em Neon, use a connection string
# "pooled" para a aplicação e, se necessário, uma "direct" separada para migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/apex4?schema=public"

# ── Auth.js ──────────────────────────────────────────────────────────────
# Gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ── Criptografia de tokens WHOOP (AES-256-GCM) ──────────────────────────
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# ── WHOOP OAuth ──────────────────────────────────────────────────────────
# "mock": WhoopClient responde com fixtures locais, nenhuma credencial necessária.
# "live": integração real (Fase 3) — exige as variáveis abaixo.
WHOOP_MODE="mock"
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
WHOOP_REDIRECT_URI="http://localhost:3000/api/whoop/oauth/callback"
# Cadastrado no WHOOP Developer Dashboard (seção Webhooks) — não é gerado localmente.
WHOOP_WEBHOOK_SECRET=""

# ── Redis (Upstash) — cache, rate limiting, filas ───────────────────────
# Se omitido em desenvolvimento, o app cai para um rate limiter em memória (ver
# src/lib/rate-limit.ts). Obrigatório em produção.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cron ─────────────────────────────────────────────────────────────────
# Segredo enviado pelo Vercel Cron (header Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# ── E-mail (futuro — reset de senha transacional) ───────────────────────
EMAIL_FROM=""
EMAIL_SERVER=""
